{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000
  },
  "provider": {
    "local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM (Chat Completions)",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "dummy",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "OmniCoder-9B": {
          "name": "OmniCoder-9B",
          "tool_call": true,
          "limit": {
            "context": 72896,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "local-vllm/OmniCoder-9B",
  "small_model": "local-vllm/OmniCoder-9B"
}